# URLs públicas sem extensão .php
<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -MultiViews
    ErrorDocument 404 /404

    # Canonicalizar /index.php para a raiz da área pública.
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php[\s?] [NC]
    RewriteRule ^index\.php$ ./ [R=301,L]

    # Redirecionar acessos públicos GET/HEAD de /pagina.php para /pagina.
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^(.+)\.php$ $1 [R=301,L,NE]

    # Resolver internamente /pagina para /pagina.php quando o arquivo existir.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>
